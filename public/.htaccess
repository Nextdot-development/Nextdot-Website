# GoDaddy Hosting Configuration for React SPA
# =============================================

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# HTTPS Redirect
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json image/svg+xml application/xml+rss
  AddEncoding gzip .gz
  AddType application/x-gzip .gz .gzip
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  
  # Don't cache HTML (SPA entry point)
  ExpiresByType text/html "access plus 0 seconds"
  
  # Cache dynamic assets
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Cache images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Cache fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  
  # Cache videos
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType video/ogg "access plus 1 month"
  
  # Cache manifests
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Add cache control headers
<IfModule mod_headers.c>
  # Never cache the SPA entry point
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # Cache hashed assets aggressively
  <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|woff2?|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Legacy URL Handling (SEO)
# =========================
# Old WordPress URLs that are still indexed. These rules run BEFORE the SPA
# fallback below, so they take effect instead of the catch-all that would
# otherwise soft-redirect every unknown path to the homepage.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 permanent redirects to the current equivalent pages
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^services/?$ /terms-of-service [R=301,L]

  # 410 Gone: permanently removed old WordPress sections. A 410 is a stronger,
  # faster deindex signal than a 404. These cover whole dead areas and any
  # sub-path under them. (Long-tail one-off old pages get a normal 404 via the
  # SPA fallback below.)
  RewriteRule ^marketing(/|$) - [G,L]
  RewriteRule ^portfolio(/|$) - [G,L]
  RewriteRule ^category(/|$) - [G,L]
  RewriteRule ^solutions(/|$) - [G,L]
  RewriteRule ^resources(/|$) - [G,L]
  RewriteRule ^service(/|$) - [G,L]
  RewriteRule ^careers(/|$) - [G,L]
  RewriteRule ^clients(/|$) - [G,L]
  RewriteRule ^clientele/?$ - [G,L]
  RewriteRule ^cases(/|$) - [G,L]
  RewriteRule ^influencers(/|$) - [G,L]
  RewriteRule ^influencer-marketing(/|$) - [G,L]
  RewriteRule ^wp-(admin|content|includes)(/|$) - [G,L]
  RewriteRule ^corporate-video- - [G,L]
  RewriteRule ^explainer-video- - [G,L]
  RewriteRule ^documentary-filmmakers- - [G,L]
  RewriteRule ^content- - [G,L]
</IfModule>

# Prerendered Route Serving (SEO)
# ===============================
# Each route is prerendered to a directory containing index.html. Apache's
# mod_dir would 301 /about to /about/ before serving it, which contradicts the
# canonical tags and sitemap entries (both use the non-slash form). Rewriting
# to the index.html directly serves it with a 200 and no redirect.
# Must run BEFORE the SPA fallback: that fallback skips real directories, so
# without this rule mod_dir takes over and issues the redirect.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# SPA Fallback Routing + real 404s
# =================================
# All public pages are prerendered (served by the rule above) and the admin
# panel is the only client-side-only area. So the app shell is served for
# /admin/* (client routing), and EVERY other unknown path returns a genuine 404
# instead of soft-serving the homepage with a 200 — which is what made old
# WordPress URLs look like real pages to Google.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Admin panel (client-side SPA, not prerendered) → serve the app shell.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^admin(/|$) /index.html [L]

  # Anything else that is not a real file/directory is genuinely not found.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>

# File Type Handling
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Disable directory listing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
